# Copy this file to .env and fill it in. AgentMedic needs an AI model that supports tool calling.

# Pick your provider: openai, gemini, groq, mistral, openrouter, deepseek, together, xai,
# ollama, lmstudio (local and free, no key needed) or azure.
# For any other OpenAI-compatible server, leave LLM_PROVIDER empty and set LLM_BASE_URL.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=

# Model names from your provider. DOCTOR_MODEL and BACKUP_MODEL fall back to FLEET_MODEL when empty.
# Azure: use your deployment names here, set LLM_BASE_URL to your endpoint, and optionally LLM_API_VERSION.
FLEET_MODEL=
DOCTOR_MODEL=
BACKUP_MODEL=

# 1 = approval-tier actions run without a human click (benchmark / unattended)
AUTO_APPROVE=0
