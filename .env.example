# Copy this file to .env and fill it in.

# 1 = scripted offline answers, no API calls (default). 0 = call a real model.
MOCK_LLM=1

# Any OpenAI-compatible endpoint (OpenAI, Gemini, HUMAIN/ALLaM, ...)
LLM_BASE_URL=
LLM_API_KEY=

# Model names
FLEET_MODEL=
DOCTOR_MODEL=
BACKUP_MODEL=

# 1 = approval-tier actions run without a human click (benchmark / unattended)
AUTO_APPROVE=0
